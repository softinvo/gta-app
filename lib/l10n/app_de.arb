  "policyTermsTitle": "Allgemeine Geschäftsbedingungen",
  "policyTermsDesc": "Lesen Sie unsere Nutzungsbedingungen und Nutzungsrichtlinien.",
  "policyPrivacyTitle": "Datenschutzrichtlinie",
